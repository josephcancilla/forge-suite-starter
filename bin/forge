#!/bin/bash
# forge — scaffold new sub-agents from a spec
# All runs wrapped in the forge-cb circuit breaker.
#
# Usage:
#   forge new <agent-name>              Scaffold from stdin or queue spec
#   forge new <agent-name> --dry-run    Scaffold to /tmp for review
#   forge spec                          Print required spec format
#   forge validate <agent-name>         Re-validate existing scaffold against DOF
#   forge retrofit-ack                  Acknowledge retrofit readiness (defer)
#   forge retrofit <agent-name>         Start retrofit work on <agent> — auto-acks readiness
#                                       [LOCKED: requires --yes-i-know until v2]
#
# Flags:
#   --dry-run            Write to /tmp/forge-<name>/, no commit
#   --tier=<name>        Token tier: sunshine | triage | cleanup | research
#   --custom-tier        Required alongside --tier if using a non-standard tier
#   --verbose            Emit every file write
#   --approve            Post-review flag — the operator runs this to record scaffold approval
#   --yes-i-know         Unlock locked commands (retrofit in v1)
#
# Paths:
#   Inputs:   ~/.forge-suite/queue/forge/<name>_spec.md  OR  stdin
#   Outputs:  ~/.forge-suite/agents/<name>/              (draft state)
#             ~/.forge-suite/outputs/forge/<YYYYMMDD_HHMM>_<name>.md (summary)
#   Audit:    ~/.forge-suite/audit/actions.log
#   Journal:  ~/.forge-suite/journal/pending/forge_<timestamp>.md
#   State:    ~/.forge-suite/dashboard/state/forge.json  (via forge-state-update)
#   Retrofit: ~/.forge-suite/agents/forge/retrofit_readiness.json
#
# Exit codes:
#   0  scaffold drafted, awaiting approval
#   1  spec invalid or missing required fields (gap report written)
#   2  name collision or path outside ~/.forge-suite/agents/
#   3  circuit breaker tripped
#   4  command locked (retrofit without --yes-i-know)
#   5  retrofit-ack: readiness not yet met (nothing to ack)
#
# Auth: Claude Code subscription only. No ANTHROPIC_API_KEY.

set -euo pipefail

FORGE_HOME="${FORGE_HOME:-$HOME/.forge-suite}"
FORGE_DIR="$FORGE_HOME/agents/forge"
QUEUE_DIR="$FORGE_HOME/queue/forge"
OUTPUT_DIR="$FORGE_HOME/outputs/forge"
AUDIT_LOG="$FORGE_HOME/audit/actions.log"
RETROFIT_JSON="$FORGE_DIR/retrofit_readiness.json"
CLAUDE_BIN="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
TIMESTAMP="$(date +%Y%m%d_%H%M)"
NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%S-07:00)"

# ── Helpers ──────────────────────────────────────────────────────────────────

log_action() {
  echo "[$NOW_ISO] forge $*" >> "$AUDIT_LOG"
}

die() {
  echo "forge: $*" >&2
  exit 1
}

require_cb() {
  if command -v forge-cb &>/dev/null; then
    forge-cb check forge --input="${1:-0}" --output="${2:-0}" || {
      log_action "circuit_breaker_tripped"
      exit 3
    }
  fi
}

# ── Command dispatch ──────────────────────────────────────────────────────────

COMMAND="${1:-}"
shift || true

case "$COMMAND" in

  # ── forge new <agent-name> [--dry-run] [--tier=X] ──────────────────
  new)
    AGENT_NAME="${1:-}"
    [[ -z "$AGENT_NAME" ]] && die "Usage: forge new <agent-name>"
    shift || true

    DRY_RUN=false
    TIER="triage"
    VERBOSE=false

    for arg in "$@"; do
      case "$arg" in
        --dry-run) DRY_RUN=true ;;
        --tier=*)  TIER="${arg#--tier=}" ;;
        --verbose) VERBOSE=true ;;
      esac
    done

    # Collision check — must not exist
    if [[ -d "$FORGE_HOME/agents/$AGENT_NAME" ]]; then
      log_action "scaffold_collision $AGENT_NAME"
      die "agent '$AGENT_NAME' already exists at $FORGE_HOME/agents/$AGENT_NAME. Use a different name."
    fi
    if [[ -f "$FORGE_HOME/bin/$AGENT_NAME" ]]; then
      log_action "bin_collision $AGENT_NAME"
      die "bin script $AGENT_NAME already exists. Use a different name."
    fi

    # Locate spec
    SPEC_FILE="$QUEUE_DIR/${AGENT_NAME}_spec.md"
    if [[ ! -f "$SPEC_FILE" ]]; then
      die "spec not found at $SPEC_FILE. Write the spec first, or pipe it via stdin (not yet supported)."
    fi

    # Behavior Contract gate — every new agent must have all 8 fields filled in the spec
    # Template: ~/.forge-suite/agents/_shared/AGENT_BEHAVIOR_CONTRACT.md
    CONTRACT_TEMPLATE="$FORGE_HOME/agents/_shared/AGENT_BEHAVIOR_CONTRACT.md"
    MISSING_FIELDS=()
    if ! grep -q "^## Behavior Contract" "$SPEC_FILE"; then
      MISSING_FIELDS+=("## Behavior Contract section (entire block)")
    else
      for field in "Identity" "Triggers" "Ambient listening" "Blast radius" "Silence contract" "Failure modes" "Dedup strategy" "Deployment"; do
        if ! grep -qE "^### [0-9]+\. $field" "$SPEC_FILE"; then
          MISSING_FIELDS+=("### <n>. $field")
        fi
      done
    fi
    if (( ${#MISSING_FIELDS[@]} > 0 )); then
      mkdir -p "$OUTPUT_DIR"
      GAP_FILE_PRE="$OUTPUT_DIR/${TIMESTAMP}_${AGENT_NAME}_gaps.md"
      {
        echo "# Behavior Contract gap report — $AGENT_NAME"
        echo
        echo "Spec at: $SPEC_FILE"
        echo "Template: $CONTRACT_TEMPLATE"
        echo
        echo "Missing required fields (every new agent must fill all eight):"
        for f in "${MISSING_FIELDS[@]}"; do
          echo "- $f"
        done
        echo
        echo "Fill each section per the template, then re-run \`forge new $AGENT_NAME\`."
      } > "$GAP_FILE_PRE"
      log_action "scaffold_rejected $AGENT_NAME missing_behavior_contract_fields=${#MISSING_FIELDS[@]}"
      echo "forge: spec is missing Behavior Contract fields. See gap report:" >&2
      echo "  $GAP_FILE_PRE" >&2
      exit 1
    fi

    require_cb 80000 15000

    # Output target
    if $DRY_RUN; then
      TARGET_DIR="/tmp/forge-$AGENT_NAME"
      mkdir -p "$TARGET_DIR"
      echo "forge: DRY RUN — writing to $TARGET_DIR"
    else
      TARGET_DIR="$FORGE_HOME/agents/$AGENT_NAME"
      mkdir -p "$TARGET_DIR"
    fi

    SUMMARY_FILE="$OUTPUT_DIR/${TIMESTAMP}_${AGENT_NAME}.md"
    GAP_FILE="$OUTPUT_DIR/${TIMESTAMP}_${AGENT_NAME}_gaps.md"
    LOG_FILE="/tmp/forge-${AGENT_NAME}-${TIMESTAMP}.log"
    FORGE_PROMPT_FILE=$(mktemp /tmp/forge-prompt.XXXXXX)
    trap "rm -f $FORGE_PROMPT_FILE" EXIT

    mkdir -p "$OUTPUT_DIR"

    # Build prompt: agent identity (CLAUDE.md) + scaffold task
    cat "$FORGE_DIR/CLAUDE.md" > "$FORGE_PROMPT_FILE"

    cat >> "$FORGE_PROMPT_FILE" << SCAFFOLD_HEAD

---

## TASK — Scaffold new agent: $AGENT_NAME

Spec file: $SPEC_FILE
Target dir: $TARGET_DIR
Summary file: $SUMMARY_FILE
Gap file: $GAP_FILE
Token tier: $TIER

Spec contents:
SCAFFOLD_HEAD

    cat "$SPEC_FILE" >> "$FORGE_PROMPT_FILE"

    cat >> "$FORGE_PROMPT_FILE" << SCAFFOLD_TASK

Required actions (execute in order using Write and Bash tools):
1. Validate the spec contains all 9 required fields from your Mandatory Scaffold Checklist PLUS the 8-field Behavior Contract (Identity, Triggers, Ambient listening, Blast radius, Silence contract, Failure modes, Dedup strategy, Deployment — see $FORGE_HOME/agents/_shared/AGENT_BEHAVIOR_CONTRACT.md). If any field is missing, write a gap report to $GAP_FILE listing the missing fields, then output "GAPS FOUND — see $GAP_FILE" and stop.
2. Write $TARGET_DIR/dof.md — Hard Failures (min 3), Soft Failures (min 2), Not Failures, Monitoring, Last Reviewed.
3. Write $TARGET_DIR/CLAUDE.md — trust ladder gates, circuit breaker caps, DOF reference path, VOICE_PROFILE reference, output path conventions, session end instructions, a "## Silence Contract" section referencing $FORGE_HOME/agents/_shared/silence_rule.md, and a "## Behavior Contract" section echoing the 8 fields from the spec.
4. Write $HOME/.forge-suite/bin/$AGENT_NAME — usage comment header, flags list, paths, exit codes, auth note (NO ANTHROPIC_API_KEY), forge-state-update call at run end. Then run: chmod +x $HOME/.forge-suite/bin/$AGENT_NAME
5. Write $SUMMARY_FILE — agent name, tier ($TIER), list of all files created, 9-field checklist + 8-field Behavior Contract confirmed (each with OK/MISSING), final line: "AWAITING APPROVAL".

Reference templates at: $FORGE_HOME/agents/_templates/forge_reference/
Behavior Contract template at: $FORGE_HOME/agents/_shared/AGENT_BEHAVIOR_CONTRACT.md
Silence rule at: $FORGE_HOME/agents/_shared/silence_rule.md
SCAFFOLD_TASK

    log_action "scaffold_start $AGENT_NAME spec=$(md5 -q "$SPEC_FILE" 2>/dev/null || md5sum "$SPEC_FILE" | cut -d' ' -f1)"

    "$CLAUDE_BIN" --model claude-sonnet-5 \
      --permission-mode acceptEdits \
      --output-format text \
      -p "$(cat "$FORGE_PROMPT_FILE")" \
      > /dev/null 2>"$LOG_FILE" || true

    if [[ ! -s "$SUMMARY_FILE" ]]; then
      echo "forge: Claude run produced no summary file. See log: $LOG_FILE"
      log_action "scaffold_error $AGENT_NAME no_summary_output"
      exit 1
    fi

    log_action "scaffold_draft $AGENT_NAME awaiting_approval"

    if ! $DRY_RUN; then
      forge-state-update forge --outcome=success \
        --json="{\"agent_specific\": {\"scaffolds_awaiting_approval\": 1, \"last_scaffolded_agent\": \"$AGENT_NAME\"}}" 2>/dev/null || true
    fi

    echo ""
    echo "Forge: scaffold drafted for '$AGENT_NAME'. Review at $TARGET_DIR"
    echo "       Run 'forge approve $AGENT_NAME' after you approve."
    exit 0
    ;;

  # ── forge approve <agent-name> ─────────────────────────────────────
  approve)
    AGENT_NAME="${1:-}"
    [[ -z "$AGENT_NAME" ]] && die "Usage: forge approve <agent-name>"

    if [[ ! -d "$FORGE_HOME/agents/$AGENT_NAME" ]]; then
      die "no scaffold found for '$AGENT_NAME' at $FORGE_HOME/agents/$AGENT_NAME"
    fi

    log_action "scaffold_approved $AGENT_NAME"

    # Update retrofit_readiness.json — add agent with today's date
    python3 - <<PYEOF
import json, datetime

with open('$RETROFIT_JSON', 'r') as f:
    data = json.load(f)

existing = [a['name'] for a in data['scaffolded_agents']]
if '$AGENT_NAME' not in existing:
    data['scaffolded_agents'].append({
        'name': '$AGENT_NAME',
        'activated_date': None,
        'hard_failures_since': 0,
        'days_operated': 0
    })

with open('$RETROFIT_JSON', 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
PYEOF

    forge-state-update forge --outcome=success \
      --json="{\"agent_specific\": {\"scaffolds_awaiting_approval\": 0, \"pending_approvals\": 0}}" 2>/dev/null || true

    echo "Forge: '$AGENT_NAME' scaffold recorded as approved. Activate it when you're ready."
    exit 0
    ;;

  # ── forge spec ──────────────────────────────────────────────────────
  spec)
    cat <<'SPEC_FORMAT'
# Forge Spec Format — Required Fields
# Save to: ~/.forge-suite/queue/forge/<agent-name>_spec.md

## Agent name
<kebab-case, no collision with existing agents or bin scripts>

## Lane
<One sentence. One job.>

## Cadence
<on-trigger | scheduled (every X) | on-demand>

## Inputs
- <file path or MCP name>

## Outputs
- <file path, format, downstream consumer>

## Reporting line
<Who reads the output: you | the Commander | <agent-name>>

## MCPs required
<List MCPs this agent needs, or "none">

## Token tier
<sunshine | triage | cleanup | research | custom (justify below)>

## Hard failures (minimum 3)
- <failure condition>

## Soft failures (minimum 2)
- <failure condition>

## DOF notes
<Any additional constraints or monitoring requirements>

## Behavior Contract
# Every new agent MUST fill all eight fields below.
# Template + field definitions: ~/.forge-suite/agents/_shared/AGENT_BEHAVIOR_CONTRACT.md
# Forge will refuse to scaffold if any field is missing or left as TBD.

### 1. Identity
- **Name:** <kebab-case>
- **Mandate:** <single sentence>

### 2. Triggers
<Enumerate every invocation: explicit @tag/slash/task, scheduled (plist path), webhook (source), CLI. Table format preferred.>

### 3. Ambient listening
<What the agent READS but does NOT act on. For each surface state the read purpose and confirm no side effect.>

### 4. Blast radius
<Enumerate every side effect (comment, task, email, file, API mutation). Each gated by a trigger from §2.>

### 5. Silence contract
<Default = silence when not explicitly addressed. If default is "act", justify. Reference silence_rule.md.>

### 6. Failure modes
<Hard (≥3), Soft (≥2), Not-failures, DOF path>

### 7. Dedup strategy
<Ledger path, dedup key, guard module>

### 8. Deployment
<Binary path, plist path if scheduled, log paths, audit log>
SPEC_FORMAT
    exit 0
    ;;

  # ── forge validate <agent-name> ────────────────────────────────────
  validate)
    AGENT_NAME="${1:-}"
    [[ -z "$AGENT_NAME" ]] && die "Usage: forge validate <agent-name>"
    AGENT_DIR="$FORGE_HOME/agents/$AGENT_NAME"
    [[ ! -d "$AGENT_DIR" ]] && die "agent '$AGENT_NAME' not found at $AGENT_DIR"

    PASS=true

    echo "Forge: validating scaffold for '$AGENT_NAME'..."

    # Check required files
    for f in CLAUDE.md dof.md; do
      if [[ ! -f "$AGENT_DIR/$f" ]]; then
        echo "  FAIL: missing $f"
        PASS=false
      else
        echo "  OK:   $f exists"
      fi
    done

    # Check bin script
    BIN="$FORGE_HOME/bin/$AGENT_NAME"
    if [[ ! -f "$BIN" ]]; then
      echo "  FAIL: missing bin script at $BIN"
      PASS=false
    elif [[ ! -x "$BIN" ]]; then
      echo "  FAIL: bin script not executable: $BIN"
      PASS=false
    else
      echo "  OK:   bin script exists and executable"
    fi

    # Check ANTHROPIC_API_KEY not used in bin script (exclude comments — auth note in header is expected)
    if [[ -f "$BIN" ]] && grep -v "^\s*#" "$BIN" | grep -q "ANTHROPIC_API_KEY" 2>/dev/null; then
      echo "  FAIL: ANTHROPIC_API_KEY found in bin script (non-comment line) — hard failure"
      PASS=false
    else
      echo "  OK:   no ANTHROPIC_API_KEY in bin script (non-comment)"
    fi

    # Check CLAUDE.md has required sections
    for section in "Trust Ladder" "Circuit Breaker" "DOF Reference" "VOICE_PROFILE" "Session End" "Silence Contract" "Behavior Contract"; do
      if grep -qi "$section" "$AGENT_DIR/CLAUDE.md" 2>/dev/null; then
        echo "  OK:   CLAUDE.md contains '$section'"
      else
        echo "  FAIL: CLAUDE.md missing section: $section"
        PASS=false
      fi
    done

    # Check dof.md has required sections
    for section in "Hard Failures" "Soft Failures" "Not Failures" "Monitoring" "Last reviewed"; do
      if grep -qi "$section" "$AGENT_DIR/dof.md" 2>/dev/null; then
        echo "  OK:   dof.md contains '$section'"
      else
        echo "  FAIL: dof.md missing section: $section"
        PASS=false
      fi
    done

    if $PASS; then
      echo "Forge: validation PASSED for '$AGENT_NAME'"
      log_action "validate_pass $AGENT_NAME"
      exit 0
    else
      echo "Forge: validation FAILED for '$AGENT_NAME'"
      log_action "validate_fail $AGENT_NAME"
      exit 1
    fi
    ;;

  # ── forge retrofit / retrofit-ack — renamed to 'upgrade' in v2 ─────
  retrofit|retrofit-ack)
    echo "forge: '$COMMAND' was renamed to 'upgrade' in Forge v2 (2026-05-15)."
    echo "  Run: forge upgrade <agent>"
    echo "  Or:  forge audit <agent>   (score-only, no spec)"
    exit 0
    ;;

  # ── forge audit <agent> | --all ────────────────────────────────────
  audit)
    AUDIT_OUT_DIR="$FORGE_HOME/outputs/forge/audit"
    mkdir -p "$AUDIT_OUT_DIR"
    TARGET="${1:-}"
    [[ -z "$TARGET" ]] && die "Usage: forge audit <agent>  |  forge audit --all"

    if [[ "$TARGET" == "--all" ]]; then
      ALL_JSON=$(python3 "$FORGE_HOME/lib/forge_audit.py" --all 2>/dev/null) || {
        log_action "audit_all_error python_failure"
        die "audit --all failed; check ~/.forge-suite/lib/forge_audit.py"
      }
      REPORT_FILE="$AUDIT_OUT_DIR/${TIMESTAMP}_all.md"
      python3 - "$ALL_JSON" "$REPORT_FILE" "$AUDIT_OUT_DIR" "$TIMESTAMP" <<'PYEOF'
import json, sys
from pathlib import Path

all_data, report_path, audit_dir, ts = json.loads(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]

# Write per-agent individual reports
def write_individual(audit):
    p = Path(audit_dir) / f"{ts}_{audit['agent']}.md"
    lines = [f"# Forge Audit — {audit['agent']} — {ts}", ""]
    lines.append(f"**Score:** {audit['score']}/100 — {audit['status']}")
    lines.append("")
    lines.append("## Criteria")
    lines.append("")
    lines.append("| # | Criterion | Result | Notes |")
    lines.append("|---|---|---|---|")
    for c in audit['criteria']:
        notes = c['notes'].replace('|', '\\|') if c['notes'] else ""
        lines.append(f"| {c['n']} | {c['name']} | {c['result']} | {notes} |")
    lines.append("")
    lines.append("## Graduation blockers")
    if audit['blockers']:
        for b in audit['blockers']:
            lines.append(f"- {b}")
    else:
        lines.append("- none")
    lines.append("")
    lines.append("## Suggested remediations")
    fails = [c for c in audit['criteria'] if c['result'] == 'FAIL']
    if not fails:
        lines.append("- none (HEALTHY)")
    else:
        for c in fails:
            lines.append(f"- Criterion {c['n']} — {c['name']}: {c['notes']}")
    lines.append("")
    lines.append("## Next step")
    if audit['status'] != 'HEALTHY':
        lines.append(f"Run `forge upgrade {audit['agent']}` to generate an upgrade spec for review.")
    else:
        lines.append("No action required.")
    p.write_text('\n'.join(lines), encoding='utf-8')

# Ranked report
sorted_audits = sorted(all_data, key=lambda x: x['score'])
healthy = sum(1 for a in all_data if a['status'] == 'HEALTHY')
degraded = sum(1 for a in all_data if a['status'] == 'DEGRADED')
needs = sum(1 for a in all_data if a['status'] == 'NEEDS-UPGRADE')

top3_needs = [a for a in sorted_audits if a['status'] == 'NEEDS-UPGRADE'][:3]

lines = [f"# Forge Audit — All Agents — {ts}", ""]
lines.append(f"**Audited:** {len(all_data)} agents")
lines.append(f"**Healthy:** {healthy}  |  **Degraded:** {degraded}  |  **Needs-Upgrade:** {needs}")
lines.append("")
lines.append("## Ranked deficit table (lowest score first)")
lines.append("")
lines.append("| Agent | Score | Status | Blockers | Report |")
lines.append("|---|---|---|---|---|")
for a in sorted_audits:
    write_individual(a)
    rpt = f"{ts}_{a['agent']}.md"
    lines.append(f"| {a['agent']} | {a['score']}/100 | {a['status']} | {len(a['blockers'])} | [{rpt}](./{rpt}) |")
lines.append("")
lines.append(f"## Top 3 NEEDS-UPGRADE")
if top3_needs:
    for a in top3_needs:
        lines.append(f"- **{a['agent']}** ({a['score']}/100) — {len(a['blockers'])} graduation blockers")
else:
    lines.append("- none (all agents HEALTHY or DEGRADED)")
lines.append("")
Path(report_path).write_text('\n'.join(lines), encoding='utf-8')
print(f"agents={len(all_data)} healthy={healthy} degraded={degraded} needs_upgrade={needs}")
PYEOF
      SUMMARY=$(python3 - "$ALL_JSON" <<'PYEOF'
import json, sys
d = json.loads(sys.argv[1])
h = sum(1 for a in d if a['status']=='HEALTHY')
deg = sum(1 for a in d if a['status']=='DEGRADED')
n = sum(1 for a in d if a['status']=='NEEDS-UPGRADE')
print(f"agents={len(d)} healthy={h} degraded={deg} needs_upgrade={n}")
PYEOF
)
      log_action "audit_all $SUMMARY report=$REPORT_FILE"
      echo "Forge audit (all): $SUMMARY"
      echo "Report: $REPORT_FILE"
      exit 0
    fi

    # Single-agent audit
    AGENT_NAME="$TARGET"
    if [[ ! -d "$FORGE_HOME/agents/$AGENT_NAME" ]]; then
      die "agent '$AGENT_NAME' not found at $FORGE_HOME/agents/$AGENT_NAME"
    fi
    AUDIT_JSON=$(python3 "$FORGE_HOME/lib/forge_audit.py" "$AGENT_NAME" 2>/dev/null) || {
      log_action "audit_error $AGENT_NAME python_failure"
      die "audit failed for $AGENT_NAME"
    }
    REPORT_FILE="$AUDIT_OUT_DIR/${TIMESTAMP}_${AGENT_NAME}.md"
    python3 - "$AUDIT_JSON" "$REPORT_FILE" "$TIMESTAMP" <<'PYEOF'
import json, sys
audit = json.loads(sys.argv[1])
report_path, ts = sys.argv[2], sys.argv[3]
lines = [f"# Forge Audit — {audit['agent']} — {ts}", ""]
lines.append(f"**Score:** {audit['score']}/100 — {audit['status']}")
lines.append("")
lines.append("## Criteria")
lines.append("")
lines.append("| # | Criterion | Result | Notes |")
lines.append("|---|---|---|---|")
for c in audit['criteria']:
    notes = c['notes'].replace('|', '\\|') if c['notes'] else ""
    lines.append(f"| {c['n']} | {c['name']} | {c['result']} | {notes} |")
lines.append("")
lines.append("## Graduation blockers")
if audit['blockers']:
    for b in audit['blockers']:
        lines.append(f"- {b}")
else:
    lines.append("- none")
lines.append("")
lines.append("## Suggested remediations")
fails = [c for c in audit['criteria'] if c['result'] == 'FAIL']
if not fails:
    lines.append("- none (HEALTHY)")
else:
    for c in fails:
        lines.append(f"- Criterion {c['n']} — {c['name']}: {c['notes']}")
lines.append("")
lines.append("## Next step")
if audit['status'] != 'HEALTHY':
    lines.append(f"Run `forge upgrade {audit['agent']}` to generate an upgrade spec for review.")
else:
    lines.append("No action required.")
open(report_path, 'w', encoding='utf-8').write('\n'.join(lines))
print(f"score={audit['score']} status={audit['status']} blockers={len(audit['blockers'])}")
PYEOF
    SCORE=$(echo "$AUDIT_JSON" | python3 -c "import json,sys; print(json.load(sys.stdin)['score'])")
    STATUS=$(echo "$AUDIT_JSON" | python3 -c "import json,sys; print(json.load(sys.stdin)['status'])")
    log_action "audit $AGENT_NAME score=$SCORE status=$STATUS report=$REPORT_FILE"
    echo "Forge audit: $AGENT_NAME → $SCORE/100 ($STATUS)"
    echo "Report: $REPORT_FILE"
    exit 0
    ;;

  # ── forge upgrade <agent> [--dry-run] ──────────────────────────────
  upgrade)
    AGENT_NAME="${1:-}"
    [[ -z "$AGENT_NAME" ]] && die "Usage: forge upgrade <agent> [--dry-run]"
    shift || true
    DRY_RUN=false
    for arg in "$@"; do
      [[ "$arg" == "--dry-run" ]] && DRY_RUN=true
      [[ "$arg" == "--apply" ]] && {
        echo "forge: --apply mode not implemented in v2.0 (spec-generation only)."
        echo "  Review the spec at ~/.forge-suite/queue/forge/${AGENT_NAME}_upgrade_spec.md"
        echo "  Apply step lands in v2.1."
        exit 4
      }
    done
    if [[ ! -d "$FORGE_HOME/agents/$AGENT_NAME" ]]; then
      die "agent '$AGENT_NAME' not found at $FORGE_HOME/agents/$AGENT_NAME"
    fi
    SPEC_RESULT=$(python3 "$FORGE_HOME/lib/forge_upgrade_spec.py" "$AGENT_NAME" $($DRY_RUN && echo --dry-run) 2>&1) || {
      log_action "upgrade_spec_error $AGENT_NAME python_failure"
      echo "$SPEC_RESULT" >&2
      die "upgrade spec generation failed for $AGENT_NAME"
    }
    SPEC_PATH=$(echo "$SPEC_RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin)['spec'])")
    SCORE=$(echo "$SPEC_RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin)['score'])")
    log_action "upgrade_spec_drafted $AGENT_NAME score=$SCORE spec=$SPEC_PATH"
    echo "Forge upgrade spec drafted: $SPEC_PATH"
    echo "  Score: $SCORE/100"
    echo "  You review; apply step deferred to v2.1."
    exit 0
    ;;

  # ── forge sweep [--dry-run] ────────────────────────────────────────
  sweep)
    DRY_RUN=false
    for arg in "$@"; do
      [[ "$arg" == "--dry-run" ]] && DRY_RUN=true
    done
    SWEEP_OUT_DIR="$FORGE_HOME/outputs/forge/sweep"
    mkdir -p "$SWEEP_OUT_DIR"
    ALL_JSON=$(python3 "$FORGE_HOME/lib/forge_audit.py" --all 2>/dev/null) || die "sweep: audit --all failed"
    TOP3=$(echo "$ALL_JSON" | python3 -c "
import json, sys
d = json.load(sys.stdin)
needs = [a for a in d if a['status'] == 'NEEDS-UPGRADE']
needs.sort(key=lambda x: x['score'])
print('\n'.join(a['agent'] for a in needs[:3]))
")
    SPEC_COUNT=0
    SPEC_LIST=""
    while IFS= read -r agent; do
      [[ -z "$agent" ]] && continue
      SPEC_RESULT=$(python3 "$FORGE_HOME/lib/forge_upgrade_spec.py" "$agent" $($DRY_RUN && echo --dry-run) 2>/dev/null) || continue
      SPEC_PATH=$(echo "$SPEC_RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin)['spec'])")
      SPEC_LIST+="$agent → $SPEC_PATH"$'\n'
      SPEC_COUNT=$((SPEC_COUNT + 1))
      log_action "sweep_spec_drafted $agent spec=$SPEC_PATH"
    done <<< "$TOP3"
    SWEEP_REPORT="$SWEEP_OUT_DIR/${TIMESTAMP}_sweep.md"
    SUMMARY=$(echo "$ALL_JSON" | python3 -c "
import json, sys
d = json.load(sys.stdin)
h = sum(1 for a in d if a['status']=='HEALTHY')
deg = sum(1 for a in d if a['status']=='DEGRADED')
n = sum(1 for a in d if a['status']=='NEEDS-UPGRADE')
print(f'{len(d)}|{h}|{deg}|{n}')
")
    IFS='|' read -r N_AGENTS HEALTHY DEGRADED NEEDS <<< "$SUMMARY"
    {
      echo "# Forge Sweep — $TIMESTAMP"
      echo ""
      echo "**Audited:** $N_AGENTS agents"
      echo "**Healthy:** $HEALTHY  |  **Degraded:** $DEGRADED  |  **Needs-Upgrade:** $NEEDS"
      echo ""
      echo "## Upgrade specs drafted ($SPEC_COUNT)"
      echo ""
      echo "$SPEC_LIST" | sed 's/^/- /'
      echo ""
      echo "## Next steps"
      echo ""
      echo "You review each spec in \`~/.forge-suite/queue/forge/<agent>_upgrade_spec.md\` and decide which to apply."
      echo "Apply step is NOT IN SCOPE for Forge v2.0 — spec-generation only."
      echo ""
    } > "$SWEEP_REPORT"
    log_action "sweep_run agents=$N_AGENTS upgrade_specs=$SPEC_COUNT report=$SWEEP_REPORT"
    echo "Forge sweep: audited $N_AGENTS agents; $NEEDS NEEDS-UPGRADE; $SPEC_COUNT upgrade specs queued for approval."
    echo "Report: $SWEEP_REPORT"
    exit 0
    ;;

  # ── forge skill-request --description "..." [--url ...] [--from ...] [--install] ──
  skill-request)
    DESCRIPTION=""
    URL=""
    FROM="commander"
    INSTALL=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --description) DESCRIPTION="${2:-}"; shift 2 ;;
        --description=*) DESCRIPTION="${1#--description=}"; shift ;;
        --url) URL="${2:-}"; shift 2 ;;
        --url=*) URL="${1#--url=}"; shift ;;
        --from) FROM="${2:-}"; shift 2 ;;
        --from=*) FROM="${1#--from=}"; shift ;;
        --install) INSTALL=true; shift ;;
        *) shift ;;
      esac
    done
    [[ -z "$DESCRIPTION" ]] && die "Usage: forge skill-request --description \"<gap>\" [--url <github>] [--install]"
    SKILL_QUEUE="$FORGE_HOME/queue/forge/skill-requests.jsonl"
    mkdir -p "$(dirname "$SKILL_QUEUE")"
    STATUS="queued"
    if $INSTALL && [[ -n "$URL" ]] && [[ -x "$FORGE_HOME/bin/forge-skill-install" ]]; then
      if "$FORGE_HOME/bin/forge-skill-install" "$URL" >/dev/null 2>&1; then
        STATUS="installed"
      else
        STATUS="install-failed"
      fi
    fi
    python3 - "$NOW_ISO" "$FROM" "$DESCRIPTION" "$URL" "$STATUS" "$SKILL_QUEUE" <<'PYEOF'
import json, sys
ts, frm, desc, url, status, path = sys.argv[1:7]
entry = {"ts": ts, "from": frm, "description": desc, "url": url or None, "status": status}
with open(path, 'a', encoding='utf-8') as f:
    f.write(json.dumps(entry) + "\n")
PYEOF
    log_action "skill_request from=$FROM status=$STATUS url=${URL:-none}"
    echo "Forge: skill request logged (status=$STATUS)."
    echo "Queue: $SKILL_QUEUE"
    exit 0
    ;;

  # ── unknown command ──────────────────────────────────────────────────────
  "")
    echo ""
    echo "Forge is now a 3-sub-agent pipeline. Use these commands:"
    echo ""
    echo "  forge-specman \"<fuzzy idea>\"   → draft spec + blind-spot questions"
    echo "  forge-builder <name>            → scaffold approved spec (all artifacts + one commit)"
    echo "  forge-designer <name>           → design pass for web-app/web-site specs"
    echo ""
    echo "Learning / teaching:"
    echo "  forge-learn all                 → daily self-review for all 3 sub-agents (also runs 2am via launchd)"
    echo "  forge-teach                     → cross-agent lesson synthesis (also runs 3am via launchd)"
    echo ""
    echo "Skill management:"
    echo "  forge-skill-install <github-url> → GitHub → validate → install Claude Code skill"
    echo ""
    echo "Legacy commands (still work):"
    echo "  forge new <agent>               → direct scaffold from spec (bypasses SpecMan; advanced use only)"
    echo "  forge spec                      → print required spec format"
    echo "  forge validate <agent>          → validate existing scaffold"
    echo ""
    echo "Forge v2 — repair / upgrade / audit existing agents:"
    echo "  forge audit <agent>             → score one agent against current canon"
    echo "  forge audit --all               → sweep all real agents, ranked deficit report"
    echo "  forge upgrade <agent>           → generate upgrade spec for review"
    echo "  forge sweep                     → audit-all + auto-generate top-3 upgrade specs"
    echo "  forge skill-request --description \"<gap>\" [--url <github>] [--install]"
    echo "                                  → log a skill gap; optionally install"
    echo ""
    exit 0
    ;;

  *)
    die "Unknown command: '$COMMAND'. Valid: new | spec | validate | approve | audit | upgrade | sweep | skill-request"
    ;;
esac
