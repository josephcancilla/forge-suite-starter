#!/usr/bin/env python3
# forge-learn - nightly self-review for the Forge sub-agents.
#
# Each sub-agent looks at its own recent outputs, scores them against its DOF,
# writes one short lesson, and the newest lessons are copied into
# agents/forge/<sub-agent>/LESSONS.md, which the sub-agent's next run reads.
#
# Usage:
#   forge-learn specman|architect|builder|designer|verifier|all   Run the loop
#   forge-learn --dry-run all                                     Print the plan, write nothing
#   forge-learn --help                                            Show this help
#
# Cost control, in order (each step is plain file checks, no Claude):
#   1. If a successful run happened in the last 18 hours, exit quietly.
#   2. If NO Forge output changed in the last 24 hours, record a "skipped"
#      receipt and exit. No circuit-breaker call, no Claude call.
#   3. Per sub-agent: if its own outputs are unchanged for 24 hours, skip it.
#   4. Only then does one small Claude call run per active sub-agent.
#
# Run receipts: every real run appends one JSON line to
#   $FORGE_HOME/state/receipts/forge-learn.jsonl  (status ok | skipped | error)
#
# Environment:
#   FORGE_HOME          base folder (default ~/.forge-suite)
#   CLAUDE_BIN          path to the claude CLI (default: found on PATH)
#   FORGE_LEARN_MODEL   model alias for the review call (default: haiku)
#
# Auth: Claude Code subscription only. No ANTHROPIC_API_KEY.

import concurrent.futures
import datetime
import json
import os
import pathlib
import shutil
import subprocess
import sys
import uuid

FORGE_HOME = pathlib.Path(os.environ.get("FORGE_HOME", pathlib.Path.home() / ".forge-suite"))
LESSONS_DIR = FORGE_HOME / "memory" / "lessons"
OUTPUTS_DIR = FORGE_HOME / "outputs" / "forge"
JOURNAL_DIR = FORGE_HOME / "journal" / "pending"
AUDIT_LOG = FORGE_HOME / "audit" / "actions.log"
STATE_DIR = FORGE_HOME / "state" / "forge"
RECEIPTS = FORGE_HOME / "state" / "receipts" / "forge-learn.jsonl"
LAST_OK = STATE_DIR / "forge-learn.last_ok"
MONITOR_LOG_DIR = FORGE_HOME / "outputs" / "monitor"  # optional: daily summaries from a monitoring agent
MODEL = os.environ.get("FORGE_LEARN_MODEL", "haiku")
TODAY = datetime.date.today().isoformat()
NOW = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
DRY_RUN = "--dry-run" in sys.argv

SUBAGENTS = ["specman", "architect", "builder", "designer", "verifier"]
RECENT_RUN_HOURS = 18
IDLE_HOURS = 24
KEEP_LESSONS = 5


def log(msg: str) -> None:
    line = f"[{NOW}] forge-learn {msg}"
    if not DRY_RUN:
        AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(AUDIT_LOG, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    print(line)


def claude_bin():
    return os.environ.get("CLAUDE_BIN") or shutil.which("claude") or str(pathlib.Path.home() / ".local" / "bin" / "claude")


def already_ran_recently() -> bool:
    try:
        age = datetime.datetime.now().timestamp() - LAST_OK.stat().st_mtime
        return age < RECENT_RUN_HOURS * 3600
    except OSError:
        return False


def record_success() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LAST_OK.write_text(NOW + "\n", encoding="utf-8")


def write_receipt(run_id: str, status: str, note: str = "", errors: int = 0, counts=None) -> None:
    try:
        RECEIPTS.parent.mkdir(parents=True, exist_ok=True)
        with open(RECEIPTS, "a", encoding="utf-8") as f:
            f.write(json.dumps({"run_id": run_id, "job": "forge-learn", "ended": NOW, "status": status,
                                "note": note, "error_count": errors, "counts": counts or {}}) + "\n")
    except OSError:
        pass  # a receipt must never break the run


def circuit_breaker_ok() -> bool:
    cb = FORGE_HOME / "bin" / "forge-cb"
    if not cb.exists():
        return True
    return subprocess.run([sys.executable, str(cb), "check", "forge"], capture_output=True).returncode == 0


def has_recent_outputs(subagent: str) -> bool:
    # Pure file times, no Claude. Fails OPEN: an unreadable folder counts as activity,
    # so a real working day is never silently skipped.
    d = OUTPUTS_DIR / subagent
    cutoff = datetime.datetime.now() - datetime.timedelta(hours=IDLE_HOURS)
    try:
        if not d.exists():
            return False
        return any(p.is_file() and datetime.datetime.fromtimestamp(p.stat().st_mtime) >= cutoff
                   for p in d.glob("*"))
    except OSError:
        return True


def write_lessons_md(subagent: str) -> None:
    # Copy the newest lessons into agents/forge/<sub>/LESSONS.md. Each sub-agent's script
    # appends that file to its prompt, so what was learned tonight shapes the next run.
    src = LESSONS_DIR / f"{subagent}_lessons.md"
    dest = FORGE_HOME / "agents" / "forge" / subagent / "LESSONS.md"
    try:
        rows = [ln.split("|", 3) for ln in src.read_text(encoding="utf-8").splitlines()
                if ln[:4].isdigit() and ln.count("|") >= 3]
        rows = [r for r in rows if r[2].strip()][-KEEP_LESSONS:][::-1]
        body = "".join(f"- **{r[2].strip().replace('**', '')[:160]}** (seen {r[0].strip()}; change: {r[3].strip()[:200]})\n"
                       for r in rows)
        if body:
            dest.write_text(f"# forge-{subagent} lessons (generated by forge-learn)\n\n{body}", encoding="utf-8")
    except OSError:
        pass


def get_day_outputs(subagent: str) -> list:
    out_dir = OUTPUTS_DIR / subagent
    if not out_dir.exists():
        return []
    return sorted(out_dir.glob(f"{TODAY.replace('-', '')}*"))


def get_monitor_findings() -> str:
    # Optional input. If you keep a monitoring agent that writes outputs/monitor/YYYYMMDD_summary.md,
    # its newest summary (today, else the last two days) is passed in as extra context.
    for back in range(0, 3):
        day = datetime.date.today() - datetime.timedelta(days=back)
        f = MONITOR_LOG_DIR / f"{day.strftime('%Y%m%d')}_summary.md"
        if f.exists():
            prefix = "" if back == 0 else f"(from {day.isoformat()}) "
            return prefix + f.read_text(encoding="utf-8")[:3000]
    return "(no monitoring findings)"


def learn_subagent(subagent: str) -> bool:
    lessons_file = LESSONS_DIR / f"{subagent}_lessons.md"
    agent_claude_md = FORGE_HOME / "agents" / "forge" / subagent / "CLAUDE.md"
    day_outputs = get_day_outputs(subagent)

    if not has_recent_outputs(subagent):
        if DRY_RUN:
            print(f"[DRY RUN] idle: no recent outputs for {subagent}, would skip the Claude call")
        else:
            log(f"learn_idle_skip {subagent}")
        return True

    if DRY_RUN:
        print(f"[DRY RUN] would call Claude for forge-learn {subagent}")
        print(f"  outputs today: {len(day_outputs)}")
        print(f"  lessons file: {lessons_file}")
        return True

    if not lessons_file.exists():
        lessons_file.parent.mkdir(parents=True, exist_ok=True)
        lessons_file.write_text(f"# {subagent.title()} Lessons\n\n*Auto-created by forge-learn.*\n", encoding="utf-8")
    JOURNAL_DIR.mkdir(parents=True, exist_ok=True)

    outputs_summary = "\n".join(p.name for p in day_outputs) or "(no outputs today)"
    prompt = f"""You are the self-review loop for forge-{subagent}, a sub-agent in the Forge build line.

Agent CLAUDE.md:
{agent_claude_md.read_text(encoding="utf-8") if agent_claude_md.exists() else "(not found)"}

Today's date: {TODAY}

Today's output files ({len(day_outputs)} total):
{outputs_summary}

Monitoring findings (optional, truncated):
{get_monitor_findings()}

Lessons file path: {lessons_file}

Instructions:
1. Read the lessons file first so you do not repeat a lesson that is already there.
2. Review today's outputs against the agent's DOF. Score each as CLEAN, SOFT_FAIL or HARD_FAIL.
3. Identify any behavior that should change on the next run.
4. Write a single lesson entry (not more than 5 lines) in this exact format:
   {TODAY} | <what happened or "(no outputs)"> | <what we learned> | <how behavior changes>
5. Append that entry to the lessons file at {lessons_file}.
6. Append a one-line digest to {JOURNAL_DIR}/forge_daily_{TODAY}.md:
   forge-learn {subagent}: <one sentence summary>

Hard constraints:
- No ANTHROPIC_API_KEY anywhere.
- Keep the run small (about 20K input and 5K output at most).
- Do not modify any agent CLAUDE.md or dof.md file. Only the two files named above may change.
"""

    log(f"learn_start {subagent}")
    try:
        result = subprocess.run(
            [claude_bin(), "--model", MODEL, "--permission-mode", "acceptEdits", "--output-format", "text", "-p"],
            input=prompt, capture_output=True, text=True, timeout=180, cwd=str(FORGE_HOME),
        )
        if result.returncode != 0:
            log(f"learn_error {subagent} claude_exit={result.returncode}")
            return False
        write_lessons_md(subagent)
        log(f"learn_complete {subagent}")
        return True
    except subprocess.TimeoutExpired:
        log(f"learn_timeout {subagent}")
        return False
    except Exception as e:  # noqa: BLE001 - report and keep the other sub-agents running
        log(f"learn_exception {subagent} {e}")
        return False


def main() -> None:
    if "--help" in sys.argv or "-h" in sys.argv:
        print("\n".join(l[2:] if l.startswith("# ") else l[1:] for l in
                        open(__file__, encoding="utf-8").read().split("\n")[1:34] if l.startswith("#")))
        sys.exit(0)
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if not args:
        print("Usage: forge-learn specman|architect|builder|designer|verifier|all [--dry-run]")
        sys.exit(1)

    targets = SUBAGENTS if args[0] == "all" else [args[0]]
    for t in targets:
        if t not in SUBAGENTS:
            print(f"forge-learn: unknown sub-agent '{t}'. Valid: {', '.join(SUBAGENTS)}, all")
            sys.exit(1)

    run_id = uuid.uuid4().hex[:12]
    if not DRY_RUN:
        if already_ran_recently():
            sys.exit(0)
        # No Forge output in 24h: no circuit-breaker call and no Claude call.
        if not any(has_recent_outputs(t) for t in targets):
            log("idle_no_forge_output - no Claude call")
            record_success()
            write_receipt(run_id, "skipped", "no Forge output in 24h")
            sys.exit(0)
        if not circuit_breaker_ok():
            log("circuit_breaker_tripped")
            write_receipt(run_id, "error", "circuit_breaker_tripped", 1)
            sys.exit(3)

    # Each sub-agent writes its own lessons file and journal line, so they can run in parallel.
    results = {}
    if len(targets) == 1:
        results[targets[0]] = learn_subagent(targets[0])
    else:
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(targets)) as ex:
            futures = {ex.submit(learn_subagent, t): t for t in targets}
            for fut in concurrent.futures.as_completed(futures):
                sub = futures[fut]
                try:
                    results[sub] = fut.result()
                except Exception as exc:  # noqa: BLE001
                    log(f"learn_exception_async {sub} {exc}")
                    results[sub] = False

    all_ok = all(results.values())
    log(f"run_complete results={json.dumps(results)}")
    if not DRY_RUN:
        write_receipt(run_id, "ok" if all_ok else "error", "", sum(not v for v in results.values()), results)
        if all_ok:
            record_success()
    sys.exit(0 if all_ok else 1)


if __name__ == "__main__":
    main()
