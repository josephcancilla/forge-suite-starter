#!/usr/bin/env bash
# forge-specman — Fuzzy English idea → Diagnosis → operator confirm → validated spec + blind-spot Qs.
#
# v2 two-phase flow (U1):
#   Phase 1: forge-specman "<fuzzy idea>"           → writes Diagnosis, exits 20.
#   Phase 2: forge-specman --confirm-diagnosis <n>  → reads redlined Diagnosis, runs blind-spot pass.
#
# Usage:
#   forge-specman "<fuzzy idea>"                         Phase 1 — Diagnosis draft
#   forge-specman "<fuzzy idea>" --type=agent            Force type (agent|script|web-app|web-site)
#   forge-specman "<fuzzy idea>" --dry-run               Write Phase 1 to /tmp/specman-<name>/
#   forge-specman --confirm-diagnosis <name>             Phase 2 — run blind-spot pass
#   forge-specman --help                                 Show usage
#
# Flags:
#   --type=<agent|script|web-app|web-site>   Force type tag (inferred otherwise, Phase 1 only)
#   --dry-run                                 Phase 1 only — write to /tmp/, skip queue
#   --confirm-diagnosis <name>                Phase 2 — finalize spec after Diagnosis is redlined
#
# Paths:
#   Output spec:   ~/.forge-suite/queue/forge/<name>_spec.md
#   Summary:       ~/.forge-suite/outputs/forge/specman/<TS>_<name>_spec.md
#   Blind-spot:    ~/.forge-suite/audit/blind-spots/<name>.log
#   Diagnosis log: ~/.forge-suite/memory/diagnosis_patterns.md
#   Journal:       ~/.forge-suite/journal/pending/specman_<TS>.md
#
# Exit codes:
#   0   spec drafted (Phase 2), awaiting final approval
#   1   fuzzy idea missing or invalid
#   2   name collision with existing agent/bin
#   3   circuit breaker tripped
#   20  Diagnosis drafted (Phase 1), awaiting redline + --confirm-diagnosis
#   21  --confirm-diagnosis called but Diagnosis placeholder not redlined
#   23  finalized spec fails the required prior-art check (lib/forge_prior_art.py)
#
# Auth: Claude Code subscription only. No ANTHROPIC_API_KEY.

set -euo pipefail

FORGE_HOME="${FORGE_HOME:-$HOME/.forge-suite}"
export PATH="$FORGE_HOME/bin:$PATH"
QUEUE_DIR="$FORGE_HOME/queue/forge"
OUTPUT_DIR="$FORGE_HOME/outputs/forge/specman"
BLINDSPOT_DIR="$FORGE_HOME/audit/blind-spots"
JOURNAL_DIR="$FORGE_HOME/journal/pending"
AUDIT_LOG="$FORGE_HOME/audit/actions.log"
DIAGNOSIS_LOG="$FORGE_HOME/memory/diagnosis_patterns.md"
CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude 2>/dev/null || echo "$HOME/.local/bin/claude")}"
TIMESTAMP="$(date +%Y%m%d_%H%M)"
NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

mkdir -p "$QUEUE_DIR" "$OUTPUT_DIR" "$BLINDSPOT_DIR" "$JOURNAL_DIR"

die() { echo "forge-specman: $*" >&2; exit 1; }
log_action() { echo "[$NOW_ISO] forge-specman $*" >> "$AUDIT_LOG"; }

if [[ "${1:-}" == "--help" || $# -lt 1 ]]; then
  sed -n '2,36p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

# Branch: Phase 2 (confirm-diagnosis) vs Phase 1 (fuzzy idea)
CONFIRM_MODE=false
CONFIRM_NAME=""
if [[ "${1:-}" == "--confirm-diagnosis" ]]; then
  CONFIRM_MODE=true
  shift
  CONFIRM_NAME="${1:-}"
  [[ -z "$CONFIRM_NAME" ]] && die "--confirm-diagnosis requires <name>"
  [[ ! "$CONFIRM_NAME" =~ ^[a-z][a-z0-9-]+$ ]] && die "invalid kebab-case name: $CONFIRM_NAME"
  shift
fi

FUZZY_IDEA=""
TYPE=""
DRY_RUN=false

if ! $CONFIRM_MODE; then
  FUZZY_IDEA="$1"
  shift
  [[ -z "$FUZZY_IDEA" ]] && die "fuzzy idea required as first arg"
fi

for arg in "$@"; do
  case "$arg" in
    --type=*)    TYPE="${arg#--type=}" ;;
    --dry-run)   DRY_RUN=true ;;
    *)           die "unknown flag: $arg" ;;
  esac
done

# Circuit breaker preflight (daily token cap; see bin/forge-cb)
forge-cb check forge || { log_action "circuit_breaker_tripped"; exit 3; }

PROMPT_FILE="$(mktemp /tmp/specman-prompt.XXXXXX)"
LOG_FILE="/tmp/forge-specman-${TIMESTAMP}.log"
trap "rm -f $PROMPT_FILE" EXIT

# Prior art: both phases share one required section template (checked by lib/forge_prior_art.py).
PRIOR_ART_TEMPLATE=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from forge_prior_art import SECTION_TEMPLATE; print(SECTION_TEMPLATE)' "$FORGE_HOME/lib")

# Lessons written by forge-learn reach this run: append them to the prompt when present.
add_lessons() {
  local f="$FORGE_HOME/agents/forge/specman/LESSONS.md"
  if [[ -f "$f" ]]; then
    { printf '\n\n---\n\n## Lessons from earlier runs (read, then apply)\n\n'; cat "$f"; } >> "$PROMPT_FILE"
  fi
}

# ========== PHASE 2: --confirm-diagnosis ==========
if $CONFIRM_MODE; then
  SPEC_FILE="$QUEUE_DIR/${CONFIRM_NAME}_spec.md"
  [[ ! -f "$SPEC_FILE" ]] && die "spec not found: $SPEC_FILE — run Phase 1 (forge-specman <idea>) first"

  if grep -q "<AWAITING CONFIRM OR REDIRECT>" "$SPEC_FILE"; then
    echo "forge-specman: Diagnosis section still contains '<AWAITING CONFIRM OR REDIRECT>' placeholder." >&2
    echo "Open $SPEC_FILE and redline the Diagnosis before running --confirm-diagnosis." >&2
    log_action "confirm_refused_placeholder $CONFIRM_NAME"
    exit 21
  fi
  if ! grep -qE "^## Diagnosis" "$SPEC_FILE"; then
    die "spec $SPEC_FILE has no '## Diagnosis' section — re-run Phase 1"
  fi

  cat "$FORGE_HOME/agents/forge/specman/CLAUDE.md" > "$PROMPT_FILE"
add_lessons
  cat >> "$PROMPT_FILE" <<SPECMAN_PHASE2

---

## TASK — Phase 2: Finalize spec with blind-spot pass

You have confirmed the Diagnosis section of this spec: $SPEC_FILE

Current spec content:
$(cat "$SPEC_FILE")

Required actions (execute in order using Edit/Write tools):

**Prior art (required):** before building something new, look for an existing tool, skill,
library, or open-source project that already does the job (search the web and GitHub, and
check the skills already installed). The spec must contain the section below, filled with
what you found (links) or what you searched for and why nothing fit, and an Adopt, Fork,
or Build decision with at least three words explaining why. Phase 2 is refused until the
section passes.

$PRIOR_ART_TEMPLATE

1. **Preserve the Diagnosis section verbatim.** Your redlines are authoritative. Do not edit.
2. **Use your confirmed Diagnosis as seed** for the rest of the spec. The "Alternative framings" and "What would have to be true for this NOT to be the right build" lines constrain scope and reveal edges — fold those into Hard/Soft failures and Blind-Spot questions.
3. **Fill all 10 fields** (Agent/Build name, Lane, Cadence, Inputs, Outputs, Reporting line, MCPs, Token tier, **Cognitive tier**, Hard/Soft failures) + 8-field Behavior Contract + type-specific fields. Tag inferred fields with \`# inferred\`.

   **Cognitive tier** (REQUIRED): one of \`opus | sonnet | haiku | no-llm\` + one-sentence justification.
   - opus = voice / multi-step reasoning / strategic synthesis
   - sonnet = formatting / light synthesis the operator reviews
   - haiku = classification / sync / health check / synthesis the operator does NOT read
   - no-llm = pure shell/Node/Python; never spawns \`claude\`
   - **Verify the tier against the script.** How often a job is scheduled is not how often it calls the model. Before picking \`haiku\` to save cost, read the script and confirm (a) it actually invokes claude and (b) how often per run.
   - **Declare spawned children.** A script that orchestrates other agents must list every child it invokes, the child's path, and the child's tier, so every model call site is visible.
   - **Runtime verification.** Mark a tier verified only after reading a log line from a real run that shows the model actually used. Reading the code is necessary but not sufficient, because config files can silently override what the code asks for.
4. **Run 5-pass blind-spot protocol.** 2–5 total questions across: edge cases, 10X adjacencies, failure-mode gaps, UX/second-order, ecosystem fit. Must be SPECIFIC to this build. Include in \`## Blind-Spot Questions (SpecMan's 5-pass)\` section.
5. **Seed blind-spot log** at $BLINDSPOT_DIR/${CONFIRM_NAME}.log — one line per question in canonical format:
   \`[<ISO>] ${CONFIRM_NAME} question_NN "<question>" answered "<awaiting>" gap=null skip_clean=null\`
   MANDATORY. Bin-level fallback will synthesize if missing, but the subprocess should do it directly.
6. **Write summary** to $OUTPUT_DIR/${TIMESTAMP}_${CONFIRM_NAME}_spec.md — path to spec + blind-spot Q count + final line "AWAITING APPROVAL".
7. **Write journal** to $JOURNAL_DIR/specman_${TIMESTAMP}.md — name, phase=2, outputs produced, blind-spot Q count.

Reference patterns:
- 9-field spec + 8-field Behavior Contract: $FORGE_HOME/agents/_shared/AGENT_BEHAVIOR_CONTRACT.md
- Silence rule: $FORGE_HOME/agents/_shared/silence_rule.md
- Promoted patterns (if the file exists): $FORGE_HOME/memory/promoted_patterns.md
- Demoted patterns (if the file exists): $FORGE_HOME/memory/demoted_patterns.md
- Prior SpecMan lessons: $FORGE_HOME/memory/lessons/specman_lessons.md
- Blind-spot patterns (may not exist yet): $FORGE_HOME/memory/blind_spot_patterns.md

Hard constraints:
- Do NOT overwrite the \`## Diagnosis\` section — it's already been redlined.
- Spec MUST include \`## Blind-Spot Questions\` section with 2–5 questions.
- No ANTHROPIC_API_KEY in any generated content.
- Never write to $FORGE_HOME/agents/${CONFIRM_NAME}/ (Builder's exclusive zone).
SPECMAN_PHASE2

  log_action "confirm_diagnosis_start $CONFIRM_NAME"
  RUN_START_EPOCH="$(date +%s)"
  export RUN_START_EPOCH FORGE_HOME

  "$CLAUDE_BIN" --model "${FORGE_MODEL:-claude-sonnet-5}" \
    --permission-mode bypassPermissions \
    --output-format text \
    -p < "$PROMPT_FILE" \
    > /dev/null 2>"$LOG_FILE" || {
    log_action "confirm_error $CONFIRM_NAME see_log=$LOG_FILE"
    echo "forge-specman: Phase 2 Claude run failed. See log: $LOG_FILE" >&2
    exit 1
  }

  # Post-run fallback: seed blind-spot log if subprocess skipped it.
  python3 - <<'PYEOF' || true
import os, re, time, sys
from pathlib import Path

home = Path(os.environ.get("FORGE_HOME", str(Path.home() / ".forge-suite")))
queue_dir = home / "queue" / "forge"
log_dir = home / "audit" / "blind-spots"
log_dir.mkdir(parents=True, exist_ok=True)
run_start = float(os.environ.get("RUN_START_EPOCH", "0"))

for spec_path in queue_dir.glob("*_spec.md"):
    if spec_path.stat().st_mtime < run_start - 1:
        continue
    name = spec_path.stem.replace("_spec", "")
    log_path = log_dir / f"{name}.log"
    if log_path.exists() and log_path.stat().st_size > 0:
        continue
    text = spec_path.read_text()
    m = re.search(r"^##\s*Blind-Spot Questions.*?$(.*?)(?=^##\s|\Z)", text, re.M | re.S)
    if not m:
        continue
    section = m.group(1)
    questions = re.findall(
        r"^\s*\d+\.\s*(?:\*\*([^:]+?):\*\*)?\s*(.+?)(?=^\s*\d+\.|\Z)",
        section, re.M | re.S,
    )
    if not questions:
        continue
    iso = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    out = [
        f"# Blind-spot Q&A log for {name}",
        "# Format: [ISO] <agent> question_NN \"<question>\" answered \"<answer>\" gap=<bool> skip_clean=<bool>",
        "# Seeded by forge-specman bin fallback.",
        "#",
    ]
    for i, (label, body) in enumerate(questions, 1):
        q = ((label + ": ") if label else "") + body.strip()
        q = re.sub(r"\s+", " ", q).replace('"', "'")[:400]
        out.append(
            f'[{iso}] {name} question_{i:02d} "{q}" answered "<awaiting>" gap=null skip_clean=null'
        )
    log_path.write_text("\n".join(out) + "\n")
    print(f"forge-specman: fallback-seeded blind-spot log for {name} ({len(questions)} Qs)", file=sys.stderr)
PYEOF

  # Append diagnosis_confirmed event to diagnosis_patterns.md
  if ! python3 "$FORGE_HOME/lib/forge_prior_art.py" "$SPEC_FILE"; then
    log_action "prior_art_gate_fail $CONFIRM_NAME"
    exit 23
  fi

  if [[ -f "$DIAGNOSIS_LOG" ]]; then
    DIAG_EXCERPT=$(awk '/^## Diagnosis/,/^## (Cadence|Blind-Spot|Behavior|Hard failures)/' "$SPEC_FILE" \
      | sed 's/|/\\|/g' | tr '\n' ' ' | head -c 200)
    echo "| $NOW_ISO | $CONFIRM_NAME | diagnosis_confirmed | (see spec) | ${DIAG_EXCERPT}... | pending | operator-confirmed; awaiting build |" >> "$DIAGNOSIS_LOG"
  fi

  log_action "confirm_diagnosis_complete $CONFIRM_NAME awaiting_approval"

  echo ""
  echo "forge-specman: Phase 2 complete — spec finalized at:"
  echo "  $SPEC_FILE"
  echo ""
  echo "Next: review Blind-Spot Questions, answer inline (or write 'skip — build as-is'),"
  echo "then run: forge-builder $CONFIRM_NAME"
  exit 0
fi

# ========== PHASE 1: Diagnosis draft ==========

# Existing-capabilities inventory: so the LLM can
# detect overlaps during Diagnosis ("cheaper/existing-thing-overlooked" check).
# Pure plumbing — no new sections, no output changes, just richer LLM context.
EXISTING_BINS=$(ls "$FORGE_HOME/bin/" 2>/dev/null | grep -v '\.bak\|\.example' | sort | tr '\n' ' ')
EXISTING_AGENTS=$(ls "$FORGE_HOME/agents/" 2>/dev/null | grep -v '^_' | sort | tr '\n' ' ')
INSTALLED_SKILLS=$(ls "$HOME/.claude/skills/" 2>/dev/null | sort | tr '\n' ' ' || echo "(none)")

cat "$FORGE_HOME/agents/forge/specman/CLAUDE.md" > "$PROMPT_FILE"
add_lessons
cat >> "$PROMPT_FILE" <<SPECMAN_PHASE1

---

## TASK — Phase 1: Diagnosis pass

Fuzzy idea (from you):
"""
$FUZZY_IDEA
"""

Type hint: ${TYPE:-<infer from idea>}
Dry run: $DRY_RUN
Target spec file: ${DRY_RUN:+/tmp/specman-<name>/<name>_spec.md or }$QUEUE_DIR/<name>_spec.md

Required actions (execute in order using Write tool):

**Prior art (required):** before designing anything new, search for an existing tool, skill,
library, or open-source project that already does this (web search, GitHub, and the skills
already installed). The spec skeleton must also contain the section below, filled with links
or with what you searched for and why nothing fit, plus an Adopt, Fork, or Build decision with
at least three words explaining why. It sits alongside the Diagnosis skeleton.

$PRIOR_ART_TEMPLATE

1. **Parse the fuzzy idea.** Extract target name (kebab-case), type (agent/script/web-app/web-site), one-sentence lane.
2. **Collision check.** Refuse if $FORGE_HOME/agents/<name>/ OR $FORGE_HOME/bin/<name> exists. Write gap note + stop (exit via die, not spec).
3. **Demotion check.** If $FORGE_HOME/memory/demoted_patterns.md exists, read it. If the idea invokes a demoted pattern, refuse unless the operator explicitly overrode it in the idea text.
4. **Write DIAGNOSIS-ONLY spec skeleton.** Phase 1 stops after Diagnosis. Fill ONLY:
   - YAML frontmatter (type, name, status: draft, generated_by, generated, phase: diagnosis)
   - \`## Agent name\` / \`## Build name\` (kebab-case)
   - \`## Lane\` (one sentence)
   - \`## Diagnosis\` section with four subsections (see template below)
   - Placeholder \`## Awaiting Phase 2 — Blind-Spot Questions\` (literal string, replaced when --confirm-diagnosis runs)

   Diagnosis template (fill all four subsections):
   \`\`\`
   ## Diagnosis

   ### Restate (your words)
   > <one paragraph mirroring your fuzzy input verbatim, in blockquote — don't paraphrase; copy your phrasing>

   ### Alternative framings
   1. <first alternative framing of the same problem — a different agent/tool/scope that would solve the same pain>
   2. <second alternative framing — orthogonal angle, not just a rewording>

   ### What would have to be true for this NOT to be the right build
   - <condition 1 — what assumption about the problem is this build making?>
   - <condition 2 — what cheaper/existing thing is being overlooked?>
   - <condition 3 — what scope boundary would make this the wrong tool?>

   ### Confirmation
   <AWAITING CONFIRM OR REDIRECT>
   \`\`\`

5. **DO NOT** fill Cadence, Inputs, Outputs, Reporting line, MCPs, Token tier, Cognitive tier, Hard/Soft failures, Behavior Contract, or Blind-Spot Questions. Those come in Phase 2.
6. **DO NOT** seed the blind-spot log in Phase 1 — Phase 2 owns that.
7. **Write summary** to $OUTPUT_DIR/${TIMESTAMP}_<name>_spec_diagnosis.md listing name, type, and final line "AWAITING DIAGNOSIS CONFIRM".
8. **Write journal** to $JOURNAL_DIR/specman_${TIMESTAMP}.md — fuzzy idea input, phase=1, name produced.
9. **Write name marker** to /tmp/forge-specman-last-name so the bin can surface it to you: \`echo "<name>" > /tmp/forge-specman-last-name\`

Reference patterns:
- 9-field spec + 8-field Behavior Contract: $FORGE_HOME/agents/_shared/AGENT_BEHAVIOR_CONTRACT.md
- Promoted patterns: $FORGE_HOME/memory/promoted_patterns.md
- Demoted patterns: $FORGE_HOME/memory/demoted_patterns.md
- Diagnosis examples: $FORGE_HOME/memory/diagnosis_patterns.md (may not exist yet)

Existing capabilities inventory (prior-art input):
Use this list when writing the "What would have to be true for this NOT to be the right build" bullets.
If the fuzzy idea overlaps with an existing bin or agent, name it specifically in the overlap bullet.

Existing bins ($FORGE_HOME/bin/):
$EXISTING_BINS

Existing agents ($FORGE_HOME/agents/):
$EXISTING_AGENTS

Installed Claude skills (~/.claude/skills/):
$INSTALLED_SKILLS

Hard constraints:
- Diagnosis MUST have all 4 subsections filled (Restate, Alternative framings (≥2), What would have to be true (≥3 bullets), Confirmation placeholder).
- Alternative framings must be GENUINELY different angles, not reworded.
- "What would have to be true" must include cheaper/existing-thing-overlooked check.
- No ANTHROPIC_API_KEY in any generated content.
- Never write to $FORGE_HOME/agents/<name>/ (Builder's exclusive zone).
- Never activate, launch, or register anything.
SPECMAN_PHASE1

log_action "diagnosis_start fuzzy_idea_hash=$(echo -n "$FUZZY_IDEA" | md5 -q 2>/dev/null || echo -n "$FUZZY_IDEA" | md5sum | cut -d' ' -f1)"
RUN_START_EPOCH="$(date +%s)"
export RUN_START_EPOCH FORGE_HOME

rm -f /tmp/forge-specman-last-name

"$CLAUDE_BIN" --model "${FORGE_MODEL:-claude-sonnet-5}" \
  --permission-mode bypassPermissions \
  --output-format text \
  -p < "$PROMPT_FILE" \
  > /dev/null 2>"$LOG_FILE" || {
  log_action "diagnosis_error see_log=$LOG_FILE"
  echo "forge-specman: Phase 1 Claude run failed. See log: $LOG_FILE" >&2
  exit 1
}

LAST_NAME=""
[[ -f /tmp/forge-specman-last-name ]] && LAST_NAME="$(cat /tmp/forge-specman-last-name)"

log_action "diagnosis_drafted name=${LAST_NAME:-unknown} awaiting_confirm"

echo ""
echo "forge-specman: Phase 1 complete — Diagnosis drafted."
echo ""
if [[ -n "$LAST_NAME" ]]; then
  echo "  Spec: $QUEUE_DIR/${LAST_NAME}_spec.md"
  echo ""
  echo "Next:"
  echo "  1. Open the spec and redline the \`## Diagnosis\` section (replace '<AWAITING CONFIRM OR REDIRECT>')."
  echo "  2. Run: forge-specman --confirm-diagnosis $LAST_NAME"
else
  echo "  Spec: $QUEUE_DIR/*_spec.md (most recent)"
  echo ""
  echo "Next: open the spec, redline the Diagnosis section, then run forge-specman --confirm-diagnosis <name>."
fi

exit 20
